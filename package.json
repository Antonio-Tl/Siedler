{
  "name": "siedler",
  "version": "1.0.0",
  "description": "3D-Inselspiel im Browser mit Online-Multiplayer, Hot-Seat, KI-Gegnern und Hologramm-Bauvorschau",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test test/*.test.js",
    "cf:build": "node scripts/build-cloudflare.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^4.22.3",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Antonio-Tl/Siedler.git"
  },
  "devDependencies": {
    "wrangler": "^4.145.0"
  }
}
